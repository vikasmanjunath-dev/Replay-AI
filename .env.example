# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Browser API base URL for the React client.
# Optional API origin. Leave empty for localhost in development and same-origin in production.
VITE_API_URL=""

# Optional outbound Switch room status updates. Register the agent with Switch out of band;
# store its agent API key in the service secret manager. Do not use a registration key here.
# Set all four values or leave all unset. The connector only posts minimal task/stage/status
# summaries to one configured room; it does not read messages or perform task approvals.
RELAY_SWITCH_BASE_URL=""
RELAY_SWITCH_AGENT_ID=""
RELAY_SWITCH_ROOM_ID=""
RELAY_SWITCH_API_KEY=""

# Backend configuration examples (set in the shell/environment running FastAPI).
GEMINI_MODEL="gemini-2.5-flash"
# `python main.py` binds to localhost by default. To bind beyond localhost, set
# RELAY_HOST to an IP address and configure RELAY_API_TOKEN or RELAY_AUTH_USERS_JSON.
# RELAY_HOST="127.0.0.1"
# Optional estimates: configure both per-million-token rates and a source/version label.
# Obtain values for the selected model/account from the current provider pricing schedule.
# RELAY_GEMINI_INPUT_USD_PER_MILLION=""
# RELAY_GEMINI_OUTPUT_USD_PER_MILLION=""
# RELAY_GEMINI_PRICING_LABEL="model and pricing schedule revision"
RELAY_DB_PATH="./relay_tasks.sqlite3"
# Optional allow-list of explicit local Git targets; IDs are shown in the dashboard, paths stay server-side.
# RELAY_REPOSITORIES_JSON='{"my-project":"/absolute/path/to/my-project"}'
# Optional GitHub REST adapter. Limit this fine-grained token to the named repositories and grant only
# Metadata:read, Contents:read, and Pull requests:write. Relay does not push commits.
# PR creation requires a human-approved/committed task and exact remote base/head SHA matches.
# RELAY_GITHUB_TOKEN=""
# RELAY_GITHUB_REPOSITORIES_JSON='{"my-project":"owner/repository"}'
RELAY_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
RELAY_API_TOKEN=""
# Optional per-user tokens; when configured this takes precedence over RELAY_API_TOKEN.
RELAY_AUTH_USERS_JSON='{}'
# Optional role map. If set, unspecified configured users are read-only viewers.
# RELAY_AUTH_ROLES_JSON='{"alice":"operator","bob":"viewer"}'
# Local development tag. Production mode requires this to be a sha256 image ID or repository@sha256 digest.
RELAY_SANDBOX_IMAGE="relay-ai-sandbox:python3.11"
# Allow-listed server-side test runner: pytest or unittest (no caller command strings).
RELAY_TEST_PROFILE="pytest"
# Trusted local development only. Leave false for untrusted repository uploads.
RELAY_ALLOW_UNSAFE_SUBPROCESS="false"
